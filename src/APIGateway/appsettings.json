{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200",
      "https://connecting-local-experience-fe.vercel.app"
    ]
  },
  "HealthChecks": {
      "Route": "/health",
      "AllowCachingResponses": false,
      "EnableDetailedOutput": false
  },
  "ReverseProxy": {
    "Routes": {
      "swagger-iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/swagger-iam/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "swagger-experience-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/swagger-experience/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "swagger-user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/swagger-user/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "swagger-booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/swagger-booking/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "experience-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/experiences/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "hosts-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/hosts/{**catch-all}"
        }
      },
      "wishlists-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/wishlists/{**catch-all}"
        }
      },
      "bookings-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "recommendations-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/recommendations/{**catch-all}"
        }
      },
      "ai-training-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/training/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "iam-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "http://localhost:5050/"
          }
        }
      },
      "experience-cluster": {
        "Destinations": {
          "experience-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai-destination": {
            "Address": "http://localhost:8000/"
          }
        }
      }
    }
  }
}
