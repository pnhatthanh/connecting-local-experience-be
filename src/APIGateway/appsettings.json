{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200"
    ]
  },
  "HealthChecks": {
      "Route": "/health",
      "AllowCachingResponses": false,
      "EnableDetailedOutput": false
  },
  "ReverseProxy": {
    "Routes": {
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "experience-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/experiences/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "hosts-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/hosts/{**catch-all}"
        }
      },
      "wishlists-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/wishlists/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "iam-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "http://localhost:5050/"
          }
        }
      },
      "experience-cluster": {
        "Destinations": {
          "experience-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}
