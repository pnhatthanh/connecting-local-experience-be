{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "experience-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/experience/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "hosts-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/hosts/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "iam-destination": {
            "Address": "http://iam-api:8080/"
          }
        }
      },
      "experience-cluster": {
        "Destinations": {
          "experience-destination": {
            "Address": "http://experience-api:8080/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://user-api:8080/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://booking-api:8080/"
          }
        }
      }
    }
  }
}
