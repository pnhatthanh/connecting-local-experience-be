{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "experience-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/experiences/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "experience-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "hosts-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/hosts/{**catch-all}"
        }
      },
      "wishlists-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/wishlists/{**catch-all}"
        }
      },
      "bookings-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "recommendations-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/recommendations/{**catch-all}"
        }
      },
      "ai-training-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/training/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "iam-destination": {
            "Address": "http://iam-api:8080/"
          }
        }
      },
      "experience-cluster": {
        "Destinations": {
          "experience-destination": {
            "Address": "http://experience-api:8080/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://user-api:8080/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://booking-api:8080/"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai-destination": {
            "Address": "http://ai-api:8000/"
          }
        }
      }
    }
  }
}
