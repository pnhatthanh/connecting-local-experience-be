									"",
									"pm.test('✓ Access token received', function() {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('accessToken');",
									"    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
									"    pm.environment.set('access_token', json.accessToken);",
									"});",
									"",
									"pm.test('✓ Refresh token received', function() {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('refreshToken');",
									"    pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
									"    pm.environment.set('refresh_token', json.refreshToken);",
									"});",
									"",
									"pm.test('✓ Token is valid JWT format', function() {",
									"    const token = pm.response.json().accessToken;",
									"    pm.expect(token.split('.')).to.have.lengthOf(3);",
									"});",
									"",
									"pm.test('✓ Response time < 2000ms', () => {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
